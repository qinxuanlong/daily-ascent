{
  "name": "daily-ascent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "vue-tsc --noEmit && vite build && gh-pages -d dist",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "build:apk": "node scripts/build-apk.js",
    "release": "node scripts/release.js",
    "release:apk": "node scripts/release.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.12"
  }
}
